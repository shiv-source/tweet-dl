{
  "name": "tweet-dl",
  "version": "0.1.0",
  "description": "Download videos from Twitter/X posts",
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "tweet-dl": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:clean": "pnpm run clean && pnpm run build",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.config.ts",
    "test:network": "TWITTER_DL_NETWORK=1 vitest run",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint --fix src/ tests/",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "cli-progress": "3.12.0",
    "commander": "13.1.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "5.2.0"
  },
  "devDependencies": {
    "@types/cli-progress": "3.11.6",
    "@types/node": "22.15.0",
    "@vitest/coverage-v8": "3.1.0",
    "eslint": "9.28.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "msw": "2.10.0",
    "prettier": "3.9.6",
    "tsx": "4.19.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.32.0",
    "vitest": "3.1.0"
  },
  "keywords": [
    "twitter",
    "x",
    "video",
    "download",
    "cli",
    "hls",
    "ffmpeg",
    "typescript",
    "tweet"
  ],
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mjs}": [
      "prettier --write"
    ]
  },
  "author": {
    "name": "Shiv Kumar",
    "url": "https://github.com/shiv-source"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shiv-source/tweet-dl"
  },
  "bugs": {
    "url": "https://github.com/shiv-source/tweet-dl/issues"
  },
  "homepage": "https://github.com/shiv-source/tweet-dl#readme",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.20.0",
  "license": "MIT"
}